# Ảnh 64 quẻ sinh bằng scripts/gen-que-images.mjs — asset nặng, không commit
.que-images/

# Ảnh đại diện tool sinh bằng scripts/gen-tool-avatars.mjs khi thử nghiệm —
# bản final (đã duyệt + optimize webp) mới vào public/tool-avatars/, commit thẳng.
.tool-avatars/

# Video pipeline — file nặng, KHÔNG commit (deliverable gửi thẳng, không phải nội dung repo)
remotion/node_modules/
remotion/out/
remotion/public/recordings/
remotion/public/audio/
# Nhạc nền: sinh lại được nguyên vẹn bằng `node scripts/gen-music-bed.mjs`
# (seed cố định ⇒ ra đúng một file), nên commit 4MB WAV là thừa.
remotion/public/music/*.wav
remotion/.remotion/

# Ảnh tải về từ Storage để render — sinh lại được, không commit.
remotion/public/img-cache/

# Kho ảnh nền tải từ Pixabay (~28MB cho 84 bức). KHÔNG commit — thứ commit là
# `lib/video/stock-manifest.json`, đủ để dựng lại kho bằng
# `node scripts/stock-ingest.mjs`. Cùng lối với tranh quẻ: file ảnh nằm ở
# Supabase Storage, repo chỉ giữ địa chỉ + provenance.
remotion/public/stock/

# Kho VIDEO nền — cùng lý do, nhưng nặng hơn hẳn (mỗi đoạn 8–30MB). Thứ commit
# là `lib/video/stock-video-manifest.json`; dựng lại bằng
# `node scripts/stock-video.mjs --bucket tone`.
remotion/public/stock-video/

