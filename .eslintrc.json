{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": ["eslint:recommended", "prettier"],
  "rules": {
    "no-unused-vars": [
      "warn",
      { "args": "none", "caughtErrors": "none", "varsIgnorePattern": "^_" }
    ],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-prototype-builtins": "off",
    "no-control-regex": "off",
    "no-useless-escape": "off",
    "no-inner-declarations": "off",
    "no-async-promise-executor": "warn",
    "no-undef": "error",
    "no-constant-condition": ["error", { "checkLoops": false }]
  },
  "globals": {
    "computeTuvi": "writable",
    "computeTubinh": "writable",
    "AnSao": "writable",
    "anSao": "writable",
    "anSaoLaSo": "writable",
    "anSaoTuBinh": "writable",
    "CACH_CUC_ALL": "writable",
    "STAR_DATA": "writable",
    "menhTamPhuong": "writable",
    "domainScores": "writable",
    "tubinhCachCucSpecial": "writable",
    "renderNav": "writable",
    "renderFooter": "writable",
    "Auth": "writable",
    "supabase": "writable",
    "paypal": "readonly",
    "gtag": "readonly",
    "dataLayer": "readonly",
    "fbq": "readonly",
    "Sentry": "readonly",
    "lucide": "readonly",
    "module": "readonly",
    "exports": "readonly",
    "require": "readonly",
    "process": "readonly",
    "__dirname": "readonly",
    "__filename": "readonly",
    "global": "readonly"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.{js,mjs,cjs}", "*.mjs", "add-sentry.py", "patch-*.js", "fix-*.py"],
      "env": { "node": true, "browser": false },
      "parserOptions": { "sourceType": "module" }
    },
    {
      "files": ["patch-*.js"],
      "env": { "node": true, "browser": false }
    },
    {
      "files": ["public/**/*.js"],
      "parserOptions": { "sourceType": "script" }
    },
    {
      "files": ["app/**/*.{js,mjs}"],
      "env": { "node": true }
    },
    {
      "files": ["public/tuvi-ansao-engine.js"],
      "rules": {
        "no-dupe-keys": "off",
        "no-redeclare": "off"
      }
    }
  ]
}
