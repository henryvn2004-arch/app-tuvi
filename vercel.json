{
  "version": 2,
  "crons": [
    { "path": "/api/cron-push",          "schedule": "0 0 * * *"  },
    { "path": "/api/cron/ops-digest",    "schedule": "30 0 * * *" },
    { "path": "/api/cron/cmo-digest",    "schedule": "0 1 * * *"  },
    { "path": "/api/cron/anomaly-alerts", "schedule": "0 */3 * * *" },
    { "path": "/api/cron/health-check", "schedule": "0,30 * * * *" },
    { "path": "/api/cron/error-alerts", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/tool-usage-alerts", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/prune-anon-trial", "schedule": "0 2 * * *" },
    { "path": "/api/cron/zalo-token", "schedule": "20 20 * * *" },
    { "path": "/api/cron/chat-nudge", "schedule": "7 * * * *" },
    { "path": "/api/cron/tien-tri-nhac", "schedule": "10 1 * * *" },
    { "path": "/api/cron/ext-metrics", "schedule": "0 22 * * *" },
    { "path": "/api/cron/nghiem-chung", "schedule": "*/15 18-22 * * *" },
    { "path": "/api/cron/xac-dinh-gio-sinh", "schedule": "*/15 23,0 * * *" },
    { "path": "/api/cron/email-cross-sell", "schedule": "0 1 * * 0,5" },
    { "path": "/api/cron/email-broadcast-drain", "schedule": "*/15 * * * *" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
