{
  "name": "tuvi-minh-bao",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-engine-built.mjs",
    "dev": "next dev",
    "prebuild": "cd tuvi-engine && npm ci && npm run build",
    "build": "next build",
    "build:engine": "cd tuvi-engine && npm run build",
    "start": "next start",
    "pretypecheck": "node scripts/ensure-engine-built.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:prices": "node scripts/check-no-hardcoded-prices.mjs",
    "check:nostore": "node scripts/check-supabase-no-store.mjs",
    "check:groups": "node scripts/check-no-hardcoded-groups.mjs",
    "check:share": "node scripts/check-shell-share.mjs",
    "check:history": "node scripts/check-shell-history.mjs",
    "check:keyframes": "node scripts/check-keyframes.mjs",
    "check:hoatdong": "node scripts/check-hoat-dong-tre.mjs",
    "check:hexagrams": "node scripts/check-hexagram-table.mjs",
    "check:laso": "node scripts/check-laso-markers.mjs",
    "check:railfields": "node scripts/check-rail-fields.mjs",
    "check:hao": "node scripts/check-hao-data.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:smoke:ui": "playwright test --config=playwright.smoke.config.ts --ui",
    "lhci": "lhci autorun",
    "check:motifs": "node scripts/check-que-motifs.mjs",
    "check:terms": "node scripts/check-terms.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/functions": "^3.7.6",
    "celestine": "^0.2.1",
    "mcp-handler": "^1.1.0",
    "mingyu-core": "^0.1.23",
    "next": "^16.2.12",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
