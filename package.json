{
  "name": "tuvi-minh-bao",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "cd tuvi-engine && npm ci && npm run build",
    "build": "next build",
    "build:engine": "cd tuvi-engine && npm run build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:smoke:ui": "playwright test --config=playwright.smoke.config.ts --ui",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/functions": "^3.7.6",
    "mcp-handler": "^1.1.0",
    "next": "^14.2.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
