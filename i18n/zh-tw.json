 "battu.tu-binh-con-goi-bat-tu": {
  "t": "子平（又稱八字）是以出生年、月、日、時四柱的天干地支為依據的論命方法，形成於宋代。以日干為基準，與其餘各柱對照，推得用神與格局，進而論斷一生運勢。",
  "h": "f6e8617c"
 },
 "battu.tu-tru-khong-doan-may-rui": {
  "t": "四柱不是用來猜吉凶，而是直指您命中缺少哪一種五行——這正是為什麼人生有順風的階段，也有一路逆流的階段。排出命盤，就能知道自己缺的是什麼。",
  "h": "b1c6d09f"
 },
 "battu.viet-rieng-cho-tu-tru-nay": {
  "t": "依子平古法為這組四柱量身撰寫——共 16 個部分：格局、十神、大運、流年。",
  "h": "f54c0d01"
 },
