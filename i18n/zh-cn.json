 "battu.tu-binh-con-goi-bat-tu": {
  "t": "子平（又称八字）是以出生年、月、日、时四柱的天干地支为依据的论命方法，形成于宋代。以日干为基准，与其余各柱对照，推得用神与格局，进而论断一生运势。",
  "h": "f6e8617c"
 },
 "battu.tu-tru-khong-doan-may-rui": {
  "t": "四柱不是用来猜吉凶，而是直指您命中缺少哪一种五行——这正是为什么人生有顺风的阶段，也有一路逆流的阶段。排出命盘，就能知道自己缺的是什么。",
  "h": "b1c6d09f"
 },
 "battu.viet-rieng-cho-tu-tru-nay": {
  "t": "依子平古法为这组四柱量身撰写——共 16 个部分：格局、十神、大运、流年。",
  "h": "f54c0d01"
 },
